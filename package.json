{
  "name": "@lpm.dev/neo.ms",
  "version": "1.1.0",
  "description": "Zero-dependency time conversion library - Modern, tree-shakeable alternative to ms package",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types",
    ".lpm",
    "README.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "lpm run typecheck && lpm run build && lpm run test && lpm run test:package && lpm run test:types",
    "test": "vitest run",
    "test:package": "node test/package/commonjs.smoke.cjs && node test/package/esm.smoke.mjs",
    "test:package:cjs": "node test/package/commonjs.smoke.cjs",
    "test:package:esm": "node test/package/esm.smoke.mjs",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "test:watch": "vitest",
    "bench": "lpm run build && vitest bench --run",
    "typecheck": "tsc --noEmit",
    "release:check": "lpm run check && lpm audit --level moderate --fail-on vuln",
    "prepublishOnly": "lpm run release:check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.ms"
  },
  "homepage": "https://github.com/ne-ooo/neo.ms#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.ms/issues"
  },
  "keywords": [
    "time",
    "ms",
    "milliseconds",
    "conversion",
    "duration",
    "parse",
    "format",
    "humanize",
    "zero-dependency",
    "tree-shakeable",
    "typescript",
    "esm"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ms": "^2.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
