{
  "name": "@lpm.dev/neo.ms",
  "version": "1.0.0",
  "description": "Zero-dependency time conversion library - Modern, tree-shakeable alternative to ms package",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".lpm",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.ms"
  },
  "homepage": "https://github.com/ne-ooo/neo.ms#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.ms/issues"
  },
  "keywords": [
    "time",
    "ms",
    "milliseconds",
    "conversion",
    "duration",
    "parse",
    "format",
    "humanize",
    "zero-dependency",
    "tree-shakeable",
    "typescript",
    "esm"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ms": "^2.1.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
